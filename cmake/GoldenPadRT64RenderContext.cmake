# Apple TV hardware lets apps write only Library/Caches and tmp (the simulator
# allows more). The pinned GoldenEye64Recomp render context points RT64's data
# folder at Library/Application Support, which cannot be created on an Apple
# TV, and RT64 creates it with the throwing std::filesystem::create_directories,
# so the Apple TV app crashed as soon as the game started. This writes a copy
# of that file that puts the folder in Caches on tvOS and, on every platform,
# creates it without throwing first (RT64 runs without it if that fails).
#
# Used by CMakeLists.txt, and by Checks in script mode:
#   cmake -DINPUT=<rt64_render_context.cpp> -DOUTPUT=<copy.cpp> -P cmake/GoldenPadRT64RenderContext.cmake

function(goldenpad_write_rt64_render_context input output)
    file(READ "${input}" text)
    set(data_path_old
        "std::filesystem::path(std::getenv(\"HOME\")) / \"Library/Application Support/GoldenPadRecompRT64\"")
    set(app_create_old
        "    app = std::make_unique<RT64::Application>(appCore, appConfig);")
    foreach(expected IN ITEMS data_path_old app_create_old)
        string(FIND "${text}" "${${expected}}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR
                "rt64_render_context.cpp changed upstream: update cmake/GoldenPadRT64RenderContext.cmake (${expected} not found)")
        endif()
    endforeach()
    string(REPLACE "${data_path_old}"
        "std::filesystem::path(std::getenv(\"HOME\")) / GOLDENPAD_RT64_DATA_SUBDIR"
        text "${text}")
    string(REPLACE "${app_create_old}"
"    if (!appConfig.dataPath.empty()) {
        std::error_code goldenpadFolderError;
        std::filesystem::create_directories(appConfig.dataPath, goldenpadFolderError);
        if (goldenpadFolderError) {
            std::fprintf(stderr, \"[GoldenPad] RT64 data folder %s unavailable (%s); RT64 runs without it\\n\",
                appConfig.dataPath.c_str(), goldenpadFolderError.message().c_str());
            appConfig.dataPath.clear();
        }
    }
${app_create_old}"
        text "${text}")
    file(WRITE "${output}"
"// Generated by cmake/GoldenPadRT64RenderContext.cmake from
// vendor/goldeneye/src/main/rt64_render_context.cpp (Apple TV data-folder fix). Do not edit.
#include <TargetConditionals.h>
#include <cstdio>
#include <system_error>
#if TARGET_OS_TV
#define GOLDENPAD_RT64_DATA_SUBDIR \"Library/Caches/GoldenPadRecompRT64\"
#else
#define GOLDENPAD_RT64_DATA_SUBDIR \"Library/Application Support/GoldenPadRecompRT64\"
#endif
#line 1 \"${input}\"
${text}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED INPUT AND DEFINED OUTPUT)
    goldenpad_write_rt64_render_context("${INPUT}" "${OUTPUT}")
endif()
